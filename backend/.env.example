# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/first_bloom?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="first_bloom_jwt_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="first_bloom_jwt_refresh_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="14d"

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
